#!/usr/bin/env php
<?php

declare(strict_types=1);

// The package has no dependencies, so its classes need no Composer autoloader. The project's autoloader registers all
// of the project's modules: only one can be loaded, and which one depends on --root.
spl_autoload_register(static function (string $class): void {
    $prefix = 'PixelLabs\\ModuleStateSync\\';
    if (str_starts_with($class, $prefix)) {
        $file = \dirname(__DIR__) . '/src/' . str_replace('\\', '/', substr($class, \strlen($prefix))) . '.php';
        if (is_file($file)) {
            require $file;
        }
    }
});

// Composer's bin proxy sets the path; without it (run directly), the package is expected in vendor/<vendor>/<package>.
$autoload = $GLOBALS['_composer_autoload_path'] ?? \dirname(__DIR__, 3) . '/autoload.php';

exit((new PixelLabs\ModuleStateSync\Application(STDOUT, STDERR))->run(\array_slice($argv, 1), $autoload));
